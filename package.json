{
  "name": "dcloud",
  "version": "2.1.0",
  "description": "Discord based encrypted cloud storage",
  "main": "index.js",
  "author": "DaDevGuy",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "docker:build": "docker build -t dcloud .",
    "docker:run": "docker run -d -p 3000:3000 --env-file .env -v $(pwd)/data:/app/data -v $(pwd)/uploads:/app/uploads -v $(pwd)/config:/app/config --name dcloud dcloud",
    "docker:compose": "docker-compose up -d",
    "docker:compose:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "discord.js": "^14.26.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "multer": "^1.4.4",
    "node-fetch": "^2.7.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
